# Public URL may be any valid HTTPS domain or an internal HTTP address.
SUBPOOL_PUBLIC_URL=https://subpool.example.com
SUBPOOL_PORT=8080

# Administrator credentials are read at startup and are never stored in PostgreSQL.
SUBPOOL_ADMIN_USERNAME=admin
SUBPOOL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional, comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
# Leave empty when Subpool is accessed directly.
SUBPOOL_TRUSTED_PROXY_CIDRS=

# Optional path to the Codex CLI used for reset-credit operations.
# The Docker image includes this executable.
SUBPOOL_CODEX_EXECUTABLE=codex

# Generate independent secrets with: openssl rand -base64 32
SUBPOOL_CREDENTIAL_KEY=replace-with-a-32-byte-base64-key
SUBPOOL_API_KEY_HMAC_KEY=replace-with-an-independent-random-key

POSTGRES_USER=subpool
# Keep this URL-safe because it is interpolated into SUBPOOL_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
POSTGRES_DB=subpool
